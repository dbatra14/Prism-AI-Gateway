# Prism configuration. Copy to .env to override; every value here is the default.
# All settings are read with the PRISM_ prefix (see app/config.py).

# --- Storage ---------------------------------------------------------------
# SQLite by default: no setup, and the file is reseeded on every startup.
# For Postgres, install the extras in requirements.txt and use:
#   PRISM_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/prism
# PRISM_DATABASE_URL=sqlite+aiosqlite:///./prism.db

# --- Upstream providers ----------------------------------------------------
# To use OpenRouter instead of local mock providers, copy these lines to .env
# and paste a newly generated key locally. Do not commit .env or share its key.
# OPENROUTER_API_KEY=replace-with-a-new-key
# PRISM_GATEWAY_CONFIG_PATH=data/gateway_config.openrouter.sample.json

# Every provider call is bounded by these. A dead provider must fail fast
# enough that failing over to the next one is still useful.
# PRISM_PROVIDER_TIMEOUT_SECONDS=30
# PRISM_PROVIDER_CONNECT_TIMEOUT_SECONDS=5

# --- Semantic cache --------------------------------------------------------
# Set the backend to "hash" to run with no model download. That falls back to
# lexical matching, which will miss reworded questions — see docs/ARCHITECTURE.md
# for the measured comparison.
# PRISM_EMBEDDING_BACKEND=fastembed
# PRISM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# PRISM_CACHE_TTL_SECONDS=86400
# PRISM_CACHE_MAX_CANDIDATES=500

# --- Admin plane -----------------------------------------------------------
# Shared secret for /admin/* and the ops console. Change this for any
# deployment that isn't a local demo.
# PRISM_ADMIN_TOKEN=prism-admin-token

# --- Privacy ---------------------------------------------------------------
# Prompt and response bodies are NOT written to the request log by default.
# PRISM_LOG_PROMPT_BODIES=false
